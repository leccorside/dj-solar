# Copie este arquivo para `.env` e ajuste os valores antes de subir o projeto:
#   cp .env.example .env
# Nunca commitar o arquivo `.env` real (já está no .gitignore).

# ==========================================
# Ambiente
# ==========================================
NODE_ENV=development

# ==========================================
# Portas expostas no host
# ==========================================
WEBSITE_PORT=5173
ADMIN_PORT=5174
API_PORT=3333
POSTGRES_PORT=5432
REDIS_PORT=6379

# ==========================================
# URLs públicas consumidas pelos frontends (Vite expõe apenas vars VITE_*)
# ==========================================
VITE_API_URL=http://localhost:3333/api/v1
VITE_SITE_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174

# ==========================================
# Banco de dados (PostgreSQL)
# ==========================================
POSTGRES_USER=djsolar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=djsolar
DATABASE_URL=postgresql://djsolar:change-me@postgres:5432/djsolar?schema=public

# ==========================================
# Redis (cache de configurações públicas e rate limit)
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# Autenticação / JWT (Passo 4)
# ==========================================
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Administrador inicial — usado pelo seed do SUPER_ADMIN (Passo 3)
# ==========================================
ADMIN_INITIAL_EMAIL=admin@djsolar.com.br
ADMIN_INITIAL_PASSWORD=change-me-strong-password

# ==========================================
# Storage de mídia (Passo 9)
# ==========================================
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# ==========================================
# E-mail / SMTP (Passo 19 / Passo 104)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=DJ Solar
SMTP_FROM_EMAIL=contato@djsolar.com.br

# ==========================================
# Analytics / Marketing (Passo 74 — configurável também via painel)
# ==========================================
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_TAG_MANAGER_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=

# ==========================================
# Google Maps (página de contato / endereço)
# ==========================================
VITE_GOOGLE_MAPS_API_KEY=

# ==========================================
# WhatsApp (botão flutuante / CTAs)
# ==========================================
WHATSAPP_DEFAULT_NUMBER=
WHATSAPP_DEFAULT_MESSAGE=Olá! Quero saber mais sobre energia solar.

# ==========================================
# Integrações futuras (arquitetura preparada — item 105 do PROMPT.md)
# ==========================================
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
